# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
AI_API_KEY=
# Groq is the default provider; this is its OpenAI-compatible endpoint.
AI_BASE_URL=https://api.groq.com/openai/v1
# GPT-OSS 20B: 1K requests/day and 8K tokens/minute on the base plan.
AI_MODEL=openai/gpt-oss-20b

# Recommended in production: cross-instance rate limiting for the Ask My AI guide.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Global daily request cap. 40 keeps the free Groq tier under ~200K tokens/day.
ASK_DAILY_LIMIT=40
