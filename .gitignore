# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local agent/tooling state
.commandcode/

# logs
*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Minecraft reference assets (not redistributable)
reference/

# development-only panorama derivatives (Mojang assets, never commit)
public/panoramas/_dev/

# development-only audio derivatives (Mojang assets, never commit)
public/audio/_dev/

# local game sources for the WASM arcade (built artifacts live in public/arcade)
/games/

# pre-compressed arcade siblings (generated for local perf testing)
public/arcade/**/*.br
public/arcade/**/*.gz
public/arcade-runtime/**/*.br
public/arcade-runtime/**/*.gz
